#!/bin/bash
#SBATCH --partition=rome
#SBATCH --job-name=bm25
#SBATCH --time=24:00:00
#SBATCH --output=./slurm_out/bm25_%j.out

set -e

# Activate your environment if needed:
# source venv/bin/activate
module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0/
module load Java/21.0.2

source activate splade

echo "Running BM25 evaluations with PyTerrier..."

# MS MARCO dev
echo ">>> Evaluating BM25 on MSMARCO passage dev"
python eval_bm25.py "irds:msmarco-passage/dev" "./index_msmarco"

# TREC DL 2019
echo ">>> Evaluating BM25 on TREC DL 2019"
python eval_bm25.py "irds:msmarco-passage/trec-dl-2019" "./index_msmarco"

# TREC DL 2020
echo ">>> Evaluating BM25 on TREC DL 2020"
python eval_bm25.py "irds:msmarco-passage/trec-dl-2020" "./index_msmarco"

# BEIR datasets (you can add/remove as needed)
for ds in arguana fiqa nfcorpus quora trec-covid webis-touche2020 dbpedia-entity fever hotpotqa nq; do
  echo ">>> Evaluating BM25 on BEIR dataset: $ds"
  python eval_bm25.py "irds:beir/${ds}/test" "./index_beir_${ds}"
done

echo "All evaluations complete!"
